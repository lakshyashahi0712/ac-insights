{
  "manifest_version": 3,
  "name": "AC Insights",
  "version": "1.0.0",
  "description": "Analytics for Apna College Premium students.",
"permissions": ["storage", "activeTab", "scripting", "webRequest"], 
"host_permissions": [
    "https://www.apnacollege.in/*",
    "https://*.wistia.com/*",
    "https://api.groq.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.apnacollege.in/*"],
      "js": [
        "utils/duration.js",
        "utils/draggable.js",
        "content/storage.js",
        "content/parser.js",
        "content/search.js",
        "content/ui.js",
        "content/bookmarks.js",
        "content/caption.js",
        "content/observer.js",
        "content/main.js"
      ],
      "css": ["styles/injected.css"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
  "16": "icons/icon16.png",
  "48": "icons/icon48.png",
  "128": "icons/icon128.png"
},
"action": {
  "default_popup": "popup/popup.html",
  "default_title": "AC Insights",
  "default_icon": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
},
  "background": {
    "service_worker": "background/service-worker.js"
  }
}